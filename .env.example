# Required for the database and authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edubridge?sslmode=require"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Optional; enables the AI tutor API
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Initial administrator only; used by npm run db:seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional public site URL, for canonical URLs/metadata
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
